# Lemon Squeezy API keys, one per mode. Get them at https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_TEST_API_KEY=
LEMON_SQUEEZY_LIVE_API_KEY=

# Either "test" or "live". Picks which API key is used. Defaults to "test" if unset.
LEMON_SQUEEZY_MODE=test

# Optional: the store the doctor checks. Defaults to every store.
# LEMON_SQUEEZY_STORE_ID=
