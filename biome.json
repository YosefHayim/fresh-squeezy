{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/node_modules",
			"!**/package.json"
		],
		"ignoreUnknown": true
	},
	"markdown": {
		"parser": {
			"frontmatter": true
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useArrowFunction": "error",
				"noExcessiveCognitiveComplexity": "error",
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 50
					}
				},
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 3
					}
				}
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"performance": {
				"noBarrelFile": "error",
				"noReExportAll": "error"
			},
			"style": {
				"noNestedTernary": "error",
				"noDefaultExport": "error",
				"useConst": "error",
				"noUselessElse": "error"
			},
			"suspicious": {
				"noVar": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.*", "**/*.spec.*"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.*"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["**/pnpm-lock.yaml"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			}
		}
	]
}
