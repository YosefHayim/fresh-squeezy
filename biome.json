{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"extends": ["code-standard/biome"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/node_modules",
			"!**/src/shared/lemon-squeezy-api-types.ts",
			"!**/.kiro",
			"!**/downloads",
			"!**/package.json"
		]
	}
}
