{
  "name": "fresh-squeezy",
  "version": "0.5.0",
  "description": "Checks that your Lemon Squeezy store is ready to take payments, from the CLI or TypeScript, plus a small typed client for the Lemon Squeezy API.",
  "keywords": [
    "lemon-squeezy",
    "lemonsqueezy",
    "billing",
    "payments",
    "subscriptions",
    "webhooks",
    "discounts",
    "license-keys",
    "cli",
    "doctor",
    "ci",
    "typescript",
    "nodejs",
    "saas"
  ],
  "license": "MIT",
  "author": "fresh-squeezy contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/fresh-squeezy.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "require": "./dist/environment.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./findings": {
      "types": "./dist/findings.d.ts",
      "import": "./dist/findings.js",
      "require": "./dist/findings.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./license": {
      "types": "./dist/license.d.ts",
      "import": "./dist/license.js",
      "require": "./dist/license.cjs"
    }
  },
  "bin": {
    "fresh-squeezy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node dist/cli.js doctor\"",
    "prod": "tsup && node dist/cli.js doctor",
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "biome check . && knip",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "check": "turbo run lint typecheck test build --output-logs=errors-only",
    "prepublishOnly": "pnpm check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "tsup": "8.5.1",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@10.33.2"
}
