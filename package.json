{
  "name": "fresh-squeezy",
  "version": "0.3.5",
  "description": "Dual-mode Lemon Squeezy ops + doctor: validate billing setup, and run docs-backed API ops (webhooks, discounts, checkouts, subscriptions, refunds, …) from CLI or TypeScript.",
  "keywords": [
    "lemon-squeezy",
    "lemonsqueezy",
    "billing",
    "payments",
    "subscriptions",
    "webhooks",
    "discounts",
    "license-keys",
    "cli",
    "validator",
    "doctor",
    "ci",
    "typescript",
    "nodejs",
    "saas"
  ],
  "license": "MIT",
  "author": "fresh-squeezy contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/fresh-squeezy.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./api-types": {
      "types": "./dist/api-types.d.ts",
      "import": "./dist/api-types.js",
      "require": "./dist/api-types.cjs"
    },
    "./resources/attributes": {
      "types": "./dist/resources/attributes.d.ts",
      "import": "./dist/resources/attributes.js",
      "require": "./dist/resources/attributes.cjs"
    },
    "./resources/registry": {
      "types": "./dist/resources/registry.d.ts",
      "import": "./dist/resources/registry.js",
      "require": "./dist/resources/registry.cjs"
    },
    "./validate/connection": {
      "types": "./dist/validate/connection.d.ts",
      "import": "./dist/validate/connection.js",
      "require": "./dist/validate/connection.cjs"
    },
    "./validate/discount": {
      "types": "./dist/validate/discount.d.ts",
      "import": "./dist/validate/discount.js",
      "require": "./dist/validate/discount.cjs"
    },
    "./validate/doctor": {
      "types": "./dist/validate/doctor.d.ts",
      "import": "./dist/validate/doctor.js",
      "require": "./dist/validate/doctor.cjs"
    },
    "./validate/license-key": {
      "types": "./dist/validate/license-key.d.ts",
      "import": "./dist/validate/license-key.js",
      "require": "./dist/validate/license-key.cjs"
    },
    "./validate/product": {
      "types": "./dist/validate/product.d.ts",
      "import": "./dist/validate/product.js",
      "require": "./dist/validate/product.cjs"
    },
    "./validate/issues": {
      "types": "./dist/validate/issues.d.ts",
      "import": "./dist/validate/issues.js",
      "require": "./dist/validate/issues.cjs"
    },
    "./validate/store": {
      "types": "./dist/validate/store.d.ts",
      "import": "./dist/validate/store.js",
      "require": "./dist/validate/store.cjs"
    },
    "./validate/subscription-plan": {
      "types": "./dist/validate/subscription-plan.d.ts",
      "import": "./dist/validate/subscription-plan.js",
      "require": "./dist/validate/subscription-plan.cjs"
    },
    "./validate/webhook": {
      "types": "./dist/validate/webhook.d.ts",
      "import": "./dist/validate/webhook.js",
      "require": "./dist/validate/webhook.cjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs"
    },
    "./augmentations": {
      "types": "./dist/augmentations.d.ts",
      "import": "./dist/augmentations.js",
      "require": "./dist/augmentations.cjs"
    }
  },
  "bin": {
    "fresh-squeezy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "LEMON_SQUEEZY_LIVE_SMOKE=1 vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:ci": "biome ci .",
    "check:standard": "code-standard check --repo .",
    "verify": "pnpm check:ci && pnpm check:standard && pnpm typecheck && pnpm test && pnpm build",
    "check:changelog": "node src/scripts/check-changelog.mjs",
    "generate:api-types": "node src/scripts/generate-api-types.mjs --update",
    "check:api-types": "node src/scripts/generate-api-types.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "code-standard": "0.2.0",
    "husky": "^9.1.7",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
