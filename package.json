{
  "name": "fresh-squeezy",
  "version": "0.3.5",
  "description": "Checks that your Lemon Squeezy store is ready to take payments, from the CLI or TypeScript, plus a small typed client for the Lemon Squeezy API.",
  "keywords": [
    "lemon-squeezy",
    "lemonsqueezy",
    "billing",
    "payments",
    "subscriptions",
    "webhooks",
    "discounts",
    "license-keys",
    "cli",
    "doctor",
    "ci",
    "typescript",
    "nodejs",
    "saas"
  ],
  "license": "MIT",
  "author": "fresh-squeezy contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/fresh-squeezy.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./findings": {
      "types": "./dist/findings.d.ts",
      "import": "./dist/findings.js",
      "require": "./dist/findings.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./license": {
      "types": "./dist/license.d.ts",
      "import": "./dist/license.js",
      "require": "./dist/license.cjs"
    }
  },
  "bin": {
    "fresh-squeezy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:ci": "biome ci .",
    "verify": "pnpm check:ci && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "husky": "^9.1.7",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
