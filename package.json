{
  "name": "fresh-squeezy",
  "version": "0.1.11",
  "description": "A CLI and TypeScript library that validates your Lemon Squeezy billing integration — stores, products, webhooks, discounts, license keys, and subscription plans — and catches misconfigurations before they ship.",
  "keywords": [
    "lemon-squeezy",
    "lemonsqueezy",
    "billing",
    "payments",
    "subscriptions",
    "webhooks",
    "discounts",
    "license-keys",
    "cli",
    "validator",
    "doctor",
    "ci",
    "typescript",
    "nodejs",
    "saas"
  ],
  "license": "MIT",
  "author": "fresh-squeezy contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/fresh-squeezy.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "fresh-squeezy": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "LEMON_SQUEEZY_LIVE_SMOKE=1 vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check:changelog": "node src/scripts/check-changelog.mjs",
    "generate:api-types": "node src/scripts/generate-api-types.mjs --update",
    "check:api-types": "node src/scripts/generate-api-types.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
